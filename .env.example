# Telegram Bot Tokens
MAIN_BOT_TOKEN=your_main_bot_token_here
FILE_BOT_TOKEN=your_file_bot_token_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=file_provider_db

# Admin Configuration
MAIN_ADMIN_ID=123456789
DATABASE_CHANNEL_ID=-1001234567890
